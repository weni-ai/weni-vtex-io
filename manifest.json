{
  "name": "weni-vtex-io",
  "vendor": "wenipartnerbr",
  "version": "0.0.1",
  "title": "Weni vtex IO",
  "description": "App for configuring features on weni",
  "dependencies": {
    "vtex.pixel-interfaces": "1.x"
  },
  "builders": {
    "node": "6.x",
    "react": "3.x",
    "store": "0.x",
    "pixel": "0.x",
    "docs": "0.x",
    "admin": "0.x",
    "messages": "1.x"
  },
  "policies": [
    {
      "name": "outbound-access",
      "attrs": {
        "host": "{{account}}.vtexcommercestable.com.br",
        "path": "/api/dataentities/*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "api.vtex.com",
        "path": "/api/*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "accounts.weni.ai",
        "path": "/auth/realms/weni-staging/protocol/openid-connect/token"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "retailsetup.weni.ai",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "retailsetup.stg.cloud.weni.ai",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "api.weni.ai",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "api.stg.cloud.weni.ai",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "integrations-engine.weni.ai",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "integrations-engine.stg.cloud.weni.ai",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "nexus.stg.cloud.weni.ai",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "nexus.weni.ai",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "/api/oms/pvt/orders/*"
      }
    },
    {
      "name": "colossus-fire-event"
    },
    {
      "name": "colossus-write-logs"
    },
    {
      "name": "read-write-any-workspace"
    },
    {
      "name": "OMSViewer"
    },
    {
      "name": "ListOrders"
    }
  ],
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema"
}
