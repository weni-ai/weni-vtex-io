{
  "memory": 256,
  "ttl": 10,
  "timeout": 2,
  "minReplicas": 2,
  "maxReplicas": 4,
  "workers": 1,
  "env": {
    "COMMERCE_API_BASE_URL": "https://retailsetup.stg.cloud.weni.ai",
    "OIDC_RP_CLIENT_ID": "vtex-app",
    "OIDC_RP_CLIENT_SECRET": "",
    "OIDC_OP_TOKEN_ENDPOINT": "https://accounts.weni.ai/auth/realms/weni-staging/protocol/openid-connect/token"
  },
  "routes": {
    "getFeatureList": {
      "path": "/_v/get-feature-list",
      "public": true
    },
    "integrateAvailableFeatures": {
      "path": "/_v/integrate-available-features",
      "public": true
    },
    "proxyAbandonedCartNotification": {
      "path": "/_v/abandoned-cart-notification",
      "public": true
    }
  }
}
